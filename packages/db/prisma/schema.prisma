generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  SAVED
  REVIEW
  APPLIED
  REJECTED
  ARCHIVED
  ACCEPTED
}

enum JobVisibility {
  PRIVATE
  PROFILE
  // Legacy value retained so existing rows remain readable. New sharing uses ShareLink.
  LINK
}

enum ShareLinkType {
  PROFILE
  JOB
}

enum ProfileVoteType {
  UPVOTE
  DOWNVOTE
}

enum RecruiterVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum McpAuditOutcome {
  SUCCESS
  DENIED
  ERROR
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  googleId       String?         @unique
  emailVerified  Boolean         @default(false)
  name           String?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile        Profile?
  jobs           Job[]
  shareLinks     ShareLink[]
  authSessions   AuthSession[]
  profileVotes   ProfileVote[]
  mcpAuditEvents McpAuditEvent[]
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Profile {
  id          String        @id @default(cuid())
  userId      String        @unique
  handle      String        @unique
  displayName String?
  headline    String?
  bio         String?       @db.Text
  location    String?
  website     String?
  isPublic    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  upvote      Int           @default(0)
  downvote    Int           @default(0)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinks  ShareLink[]
  votes       ProfileVote[]

  @@index([isPublic])
}

model ProfileVote {
  id        String          @id @default(cuid())
  voterId   String
  profileId String
  type      ProfileVoteType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  voter     User            @relation(fields: [voterId], references: [id], onDelete: Cascade)
  profile   Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([voterId, profileId])
  @@index([profileId])
}

model Job {
  id              String             @id @default(cuid())
  company         String
  title           String?
  applyLink       String?
  url             String?
  source          String?
  location        String?
  salary          String?
  companyWebsite  String?
  companyLinkedin String?
  companyX        String?
  description     String?            @db.Text
  personalNotes   String?            @db.Text
  requirements    Json?
  fitScore        Int?
  matchReason     String?            @db.Text
  missingSkills   Json?
  resumeVersion   String?
  researchSources Json?
  lastEnrichedAt  DateTime?
  status          JobStatus          @default(SAVED)
  visibility      JobVisibility      @default(PRIVATE)
  ownerId         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  recruiters      RecruiterContact[]
  owner           User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shareLinks      ShareLink[]
  mcpAuditEvents  McpAuditEvent[]

  @@unique([ownerId, url])
  @@index([ownerId])
  @@index([status])
  @@index([visibility])
  @@index([fitScore])
  @@index([createdAt])
}

model RecruiterContact {
  id                 String                      @id @default(cuid())
  jobId              String
  name               String?
  role               String?
  email              String?
  link               String?
  sourceUrl          String?
  notes              String?                     @db.Text
  verificationStatus RecruiterVerificationStatus @default(UNVERIFIED)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  job                Job                         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model McpAuditEvent {
  id           String          @id @default(cuid())
  userId       String
  workosUserId String
  clientId     String
  jobId        String?
  toolName     String
  outcome      McpAuditOutcome
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([clientId, createdAt])
  @@index([jobId])
}

model ShareLink {
  id        String        @id @default(cuid())
  token     String        @unique @default(cuid())
  type      ShareLinkType
  userId    String
  profileId String?
  jobId     String?
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job       Job?          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([profileId])
  @@index([jobId])
  @@index([revokedAt])
}


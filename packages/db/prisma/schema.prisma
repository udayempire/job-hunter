generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  SAVED
  REVIEW
  APPLIED
  REJECTED
  ARCHIVED
  ACCEPTED
}

enum ApplicationStatus {
  DRAFT
  READY
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum JobVisibility {
  PRIVATE
  PROFILE
  // Legacy value retained so existing rows remain readable. New sharing uses ShareLink.
  LINK
}

enum ShareLinkType {
  PROFILE
  JOB
}

enum ProfileVoteType {
  UPVOTE
  DOWNVOTE
}

enum RecruiterVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum McpAuditOutcome {
  SUCCESS
  DENIED
  ERROR
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  googleId              String?                @unique
  emailVerified         Boolean                @default(false)
  name                  String?
  image                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  profile               Profile?
  jobs                  Job[]
  shareLinks            ShareLink[]
  authSessions          AuthSession[]
  profileVotes          ProfileVote[]
  mcpConnections        McpConnection[]
  mcpAuthorizationCodes McpAuthorizationCode[]
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Profile {
  id          String        @id @default(cuid())
  userId      String        @unique
  handle      String        @unique
  displayName String?
  headline    String?
  bio         String?       @db.Text
  location    String?
  website     String?
  isPublic    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  upvote      Int           @default(0)
  downvote    Int           @default(0)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinks  ShareLink[]
  votes       ProfileVote[]

  @@index([isPublic])
}

model ProfileVote {
  id        String          @id @default(cuid())
  voterId   String
  profileId String
  type      ProfileVoteType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  voter     User            @relation(fields: [voterId], references: [id], onDelete: Cascade)
  profile   Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([voterId, profileId])
  @@index([profileId])
}

model Job {
  id              String             @id @default(cuid())
  company         String
  title           String?
  applyLink       String?
  url             String?
  source          String?
  location        String?
  salary          String?
  companyWebsite  String?
  companyLinkedin String?
  companyX        String?
  description     String?            @db.Text
  personalNotes   String?            @db.Text
  requirements    Json?
  fitScore        Int?
  matchReason     String?            @db.Text
  missingSkills   Json?
  resumeVersion   String?
  researchSources Json?
  lastEnrichedAt  DateTime?
  status          JobStatus          @default(SAVED)
  visibility      JobVisibility      @default(PRIVATE)
  ownerId         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  applications    Application[]
  recruiters      RecruiterContact[]
  owner           User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shareLinks      ShareLink[]
  mcpAuditEvents  McpAuditEvent[]

  @@unique([ownerId, url])
  @@index([ownerId])
  @@index([status])
  @@index([visibility])
  @@index([fitScore])
  @@index([createdAt])
}

model RecruiterContact {
  id                 String                      @id @default(cuid())
  jobId              String
  name               String?
  role               String?
  email              String?
  link               String?
  sourceUrl          String?
  notes              String?                     @db.Text
  verificationStatus RecruiterVerificationStatus @default(UNVERIFIED)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  job                Job                         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model McpOAuthClient {
  id                      String                 @id @default(cuid())
  clientId                String                 @unique
  clientName              String
  redirectUris            String[]
  tokenEndpointAuthMethod String                 @default("none")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  connections             McpConnection[]
  authorizationCodes      McpAuthorizationCode[]
}

model McpConnection {
  id            String          @id @default(cuid())
  userId        String
  oauthClientId String
  scopes        String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthClient   McpOAuthClient  @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  tokens        McpToken[]
  auditEvents   McpAuditEvent[]

  @@index([userId, revokedAt])
  @@index([oauthClientId])
}

model McpAuthorizationCode {
  id            String         @id @default(cuid())
  codeHash      String         @unique
  userId        String
  oauthClientId String
  redirectUri   String
  codeChallenge String
  scopes        String[]
  resource      String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthClient   McpOAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([oauthClientId])
  @@index([expiresAt])
}

model McpToken {
  id               String        @id @default(cuid())
  connectionId     String
  accessTokenHash  String        @unique
  refreshTokenHash String        @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  connection       McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, revokedAt])
  @@index([accessExpiresAt])
  @@index([refreshExpiresAt])
}

model McpAuditEvent {
  id           String          @id @default(cuid())
  connectionId String
  jobId        String?
  toolName     String
  outcome      McpAuditOutcome
  createdAt    DateTime        @default(now())
  connection   McpConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  job          Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([connectionId, createdAt])
  @@index([jobId])
}

model ShareLink {
  id        String        @id @default(cuid())
  token     String        @unique @default(cuid())
  type      ShareLinkType
  userId    String
  profileId String?
  jobId     String?
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job       Job?          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([profileId])
  @@index([jobId])
  @@index([revokedAt])
}

model Application {
  id               String            @id @default(cuid())
  jobId            String
  resumeVersion    String?
  coverLetter      String?           @db.Text
  recruiterMessage String?           @db.Text
  answers          Json?
  status           ApplicationStatus @default(DRAFT)
  appliedAt        DateTime?
  followUpAt       DateTime?
  notes            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([followUpAt])
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "job-hunter-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "COOKIE_CROSS_SITE": "true",
    "EXTENSION_ORIGINS": "chrome-extension://igjomiklldkcenldapmemokmnjddeggk",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "api.jobhunti.space",
      "zone_name": "jobhunti.space",
      "custom_domain": true,
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "aacca227ec7943c79d2905e72112fbbc",
    },
  ],
}

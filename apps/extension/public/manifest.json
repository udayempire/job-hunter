{
  "manifest_version": 3,
  "name": "Job Hunti Clip",
  "description": "Save a job to Job Hunti while you browse.",
  "version": "0.1.0",
  "action": {
    "default_title": "Save to Job Hunti",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["<all_urls>"]
}
